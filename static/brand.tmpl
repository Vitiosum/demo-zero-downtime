{{define "topbar"}}<header class="cc-topbar">
  <div class="cc-container cc-topbar__inner">
    <a href="https://www.clever.cloud" target="_blank" rel="noopener" aria-label="Clever Cloud">{{template "cc-logo"}}</a>
    <span class="cc-topbar__sep"></span>
    <div class="cc-topbar__demo"><small>Démo</small>Déploiements sans coupure</div>
    <span class="cc-topbar__spacer"></span>
    <nav class="cc-topbar__nav" aria-label="Navigation">
      <a class="cc-pill cc-hide-sm" href="/">L'app</a>
      <a class="cc-pill cc-hide-sm" href="/tower">Tour de contrôle</a>
      {{if .CC.Live}}<span class="cc-pill cc-pill--live"><span class="cc-dot"></span>Live on Clever Cloud</span>{{else}}<span class="cc-pill cc-pill--muted"><span class="cc-dot cc-dot--muted"></span>Local · hors Clever Cloud</span>{{end}}
    </nav>
  </div>
</header>{{end}}
{{define "platform"}}<div class="cc-platform">
  <div class="cc-platform__head">
    <h3>Cette page vient de</h3>
    {{if .CC.Live}}<span class="cc-pill cc-pill--ok"><span class="cc-dot"></span>{{with .CC.InstanceType}}{{.}}{{else}}production{{end}}</span>{{else}}<span class="cc-pill cc-pill--muted">local</span>{{end}}
  </div>
  <dl class="cc-kv">
    <div><dt>Release</dt><dd>{{.Release.Version}} · {{.Release.Name}}</dd></div>
    <div><dt>Instance</dt>{{with .CC.Instance}}<dd>{{.}}</dd>{{else}}<dd class="zd-empty">injecté au déploiement</dd>{{end}}</div>
    <div><dt>Processus</dt><dd>{{.Boot}} · lancé il y a {{.Uptime}}</dd></div>
    <div><dt>Commit déployé</dt>{{with .CC.ShortCommit}}<dd>{{.}}</dd>{{else}}<dd class="zd-empty">{{if $.CC.Live}}non injecté{{else}}injecté au déploiement{{end}}{{with $.BuiltFrom}} · binaire {{.}}{{end}}</dd>{{end}}</div>
    <div><dt>Application</dt>{{with .CC.AppName}}<dd>{{.}}</dd>{{else}}<dd class="zd-empty">injecté au déploiement</dd>{{end}}</div>
    <div><dt>Déploiement</dt>{{with .CC.Deployment}}<dd>{{.}}</dd>{{else}}<dd class="zd-empty">injecté au déploiement</dd>{{end}}</div>
  </dl>
  <div class="cc-platform__foot">Variables injectées par la plateforme : <a href="https://www.clever.cloud/developers/doc/develop/common-configuration/environment-variables/reference/" target="_blank" rel="noopener">référence</a>.</div>
</div>{{end}}
{{define "footer"}}<footer class="cc-footer">
  <div class="cc-container">
    <div class="cc-footer__inner">
      <div class="cc-footer__brand">
        {{template "cc-logo"}}
        <p>PaaS européen entièrement managé. Déployez en git push, la plateforme s'occupe du reste.</p>
        <div class="cc-trust"><span>ISO 27001</span><span>HDS</span><span>HÉBERGÉ EN FRANCE</span></div>
      </div>
      <div>
        <h4>Documentation</h4>
        <ul>
          <li><a href="https://www.clever.cloud/developers/doc/develop/common-configuration/healthcheck/" target="_blank" rel="noopener">Health check de déploiement</a></li>
          <li><a href="https://www.clever.cloud/developers/doc/develop/best-practices/blue-green/" target="_blank" rel="noopener">Blue/green sur Clever Cloud</a></li>
          <li><a href="https://www.clever.cloud/developers/doc/develop/common-configuration/scaling/" target="_blank" rel="noopener">Scalabilité</a></li>
        </ul>
      </div>
      <div>
        <h4>Aller plus loin</h4>
        <ul>
          <li><a class="is-cert" href="https://academy.clever.cloud/" target="_blank" rel="noopener">Certification Clever Cloud ↗</a></li>
          <li><a href="https://github.com/Vitiosum/demo-zero-downtime" target="_blank" rel="noopener">Code source sur GitHub</a></li>
          <li><a href="https://www.clever.cloud" target="_blank" rel="noopener">clever.cloud</a></li>
        </ul>
      </div>
    </div>
    <div class="cc-footer__bottom"><span>Démo réalisée par l'équipe avant-vente Clever Cloud</span><span>© 2026 Clever Cloud</span></div>
  </div>
</footer>{{end}}
